<?xml version="1.0" encoding="utf-8"?>
<!-- The floating Scribe button: it only needs to know when a keyboard opens
     and whose it is, and whether the box is a password box. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowsChanged|typeWindowStateChanged|typeViewFocused"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="100"
    android:description="@string/float_description"
    android:summary="@string/float_summary" />
